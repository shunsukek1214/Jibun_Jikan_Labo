# =========================================================
# Azure Speech
# =========================================================
AZURE_SPEECH_KEY=replace_me
AZURE_SPEECH_REGION=japaneast

# =========================================================
# Azure OpenAI
# =========================================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace_me
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

# =========================================================
# MySQL
# ローカル例。パスワードに@などを含む場合はURLエンコードしてください。
# Azure利用時はホスト名・ユーザー名・DB名を置き換えます。
# =========================================================
DATABASE_URL=mysql+pymysql://app_user:replace_me@localhost:3306/jibun_jikan_lab?charset=utf8mb4
DATABASE_SSL_ENABLED=false

# =========================================================
# アプリ共通
# localhostへ統一します。127.0.0.1と混在させません。
# =========================================================
APP_ENV=development
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Tokyo
BACKEND_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# =========================================================
# Google OAuth / OpenID Connect
# 秘密情報はバックエンドだけに置きます。
# =========================================================
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_AFTER_LOGIN_URL=http://localhost:3000/night
FRONTEND_AUTH_ERROR_URL=http://localhost:3000
OAUTH_STATE_TTL_MINUTES=10

# =========================================================
# アプリログインセッションCookie
# ローカルHTTPではSECURE=false、本番HTTPSではtrueにします。
# =========================================================
SESSION_COOKIE_NAME=jibun_session
SESSION_TTL_DAYS=7
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# =========================================================
# Googleトークン暗号化
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# で生成します。紛失すると既存トークンを復号できません。
# =========================================================
TOKEN_ENCRYPTION_KEY=replace_me

# =========================================================
# LINE Messaging API
# =========================================================
LINE_CHANNEL_ACCESS_TOKEN=replace_me
LINE_MESSAGING_CHANNEL_SECRET=replace_me

# =========================================================
# LINE Login
# =========================================================
LINE_LOGIN_CHANNEL_ID=replace_me
LINE_LOGIN_CHANNEL_SECRET=replace_me
LINE_LOGIN_CALLBACK_URL=http://localhost:8000/api/line/callback

# =========================================================
# Next.js URL
# =========================================================
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_LINE_RESULT_URL=http://localhost:3000/settings/line
FRONTEND_TODAY_URL=http://localhost:3000/today
GOOGLE_CALENDAR_URL=https://calendar.google.com/calendar/u/0/r/day

# =========================================================
# 内部バッチとAPScheduler
# 本番で複数workerを起動する場合はSCHEDULER_ENABLED=falseにし、
# スケジューラーを別プロセスへ分離してください。
# =========================================================
INTERNAL_BATCH_TOKEN=replace_me_with_long_random_value
SCHEDULER_ENABLED=true
REMINDER_TIMES=07:00,10:00,13:00,15:00,17:00